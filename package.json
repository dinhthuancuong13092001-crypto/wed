{
  "name": "school-cms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "next build",
    "start": "node server.mjs",
    "preview": "node scripts/preview.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx tests/integration.ts",
    "test:mysql": "node --test tests/mysql-adapter.mjs",
    "format": "prettier --write pages components lib scripts tests styles docs README.md package.json tsconfig.json next.config.mjs server.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-text-align": "^3.0.0",
    "@tiptap/extension-youtube": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "dotenv": "^17.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.5",
    "next": "^16.3.8",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
